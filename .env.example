# Confluence
CONFLUENCE_URL=https://confluence.mycompany.com
CONFLUENCE_USERNAME=your_user
CONFLUENCE_TOKEN=your_personal_access_token
CONFLUENCE_SPACE_KEY=MYSPACE

# LLM (Qwen3-32B через OpenAI-совместимый API)
LLM_URL=http://srv-llm:8000/v1
LLM_API_KEY=sk-...

# Embedding model (мультиязычная, <500 МБ)
EMBEDDING_MODEL=sentence-transformers/paraphrase-multilingual-MiniLM-L12-v2

# Домен и SSL
DOMAIN=confluence-bot.mycompany.com
SSL_CRT_PATH=/certs/fullchain.crt
SSL_KEY_PATH=/certs/privkey.key

# Режим векторной БД (persistent или memory)
VECTOR_DB_MODE=persistent
